server {
    server_name winds-os.com www.winds-os.com;

      location / {
         proxy_pass http://localhost:5010;
         client_max_body_size 2G;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/winds-os.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/winds-os.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}


server {
    server_name api2.winds-os.com;

      location / {
         proxy_pass http://127.0.0.1:5012;
